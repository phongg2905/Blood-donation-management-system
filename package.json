{
  "name": "blood-donation-management",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "prepare": "pnpm build:shared",
    "build:shared": "pnpm --filter @blood/shared-types --filter @blood/shared-validation build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @blood/api --filter @blood/web dev",
    "dev:web": "pnpm build:shared && pnpm --filter @blood/web dev",
    "dev:api": "pnpm build:shared && pnpm --filter @blood/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @blood/api db:generate",
    "db:migrate": "pnpm --filter @blood/api db:migrate",
    "db:deploy": "pnpm --filter @blood/api db:deploy",
    "db:studio": "pnpm --filter @blood/api db:studio",
    "db:seed": "pnpm --filter @blood/api db:seed",
    "test": "pnpm build:shared && pnpm -r test"
  },
  "devDependencies": {
    "@blood/eslint-config": "workspace:*",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
