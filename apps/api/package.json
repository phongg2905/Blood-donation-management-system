{
  "name": "@blood/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/database/seed/index.ts",
    "test": "tsx --test src/app.test.ts src/domain.test.ts src/database.test.ts src/phase1.test.ts"
  },
  "dependencies": {
    "@blood/shared-types": "workspace:*",
    "@blood/shared-validation": "workspace:*",
    "@prisma/client": "6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "prisma": "6.19.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
