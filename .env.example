NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blood_donation?schema=public&connect_timeout=3&pool_timeout=3
CORS_ORIGIN=http://localhost:5173
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=blood_donation
POSTGRES_PORT=5432
VITE_API_BASE_URL=/api

# Phase 2 frontend auth adapter.
# true  (default) -> MockAuthService: no backend needed, demo accounts in the UI
# false           -> ApiAuthService against the real /auth endpoints
# Set to false once the backend auth API is integrated; see
# apps/web/TASK_UNTIL_AUTH_INTEGRATED.md.
VITE_USE_MOCK_API=true

# Phase 2 auth. Secrets must be at least 32 characters — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=30
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional initial admin account, created by `pnpm db:seed`. Leave unset to skip.
# Never commit a real password.
# ADMIN_EMAIL=admin@example.local
# ADMIN_PASSWORD=
# ADMIN_FULL_NAME=Quản trị viên

