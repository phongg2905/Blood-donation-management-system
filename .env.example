NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blood_donation?schema=public&connect_timeout=3&pool_timeout=3
CORS_ORIGIN=http://localhost:5173
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=blood_donation
POSTGRES_PORT=5432
VITE_API_BASE_URL=/api

# Phase 2 auth (optional in Phase 1). Secrets must be at least 32 characters.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# Optional initial admin account, created by `pnpm db:seed`. Leave unset to skip.
# Never commit a real password.
# ADMIN_EMAIL=admin@example.local
# ADMIN_PASSWORD=
# ADMIN_FULL_NAME=Quản trị viên

