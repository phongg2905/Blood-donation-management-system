NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blood_donation?schema=public&connect_timeout=3&pool_timeout=3
CORS_ORIGIN=http://localhost:5173
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=blood_donation
POSTGRES_PORT=5432
VITE_API_BASE_URL=/api

# Phase 2 frontend auth adapter.
# false (default) -> ApiAuthService against the real /auth endpoints
# true            -> MockAuthService for isolated UI work only
VITE_USE_MOCK_API=false

# Removable demo account picker on login (development only). false hides it.
VITE_SHOW_DEMO_LOGIN=true

# Phase 3 data source, independent of authentication. Mock is ignored in production.
# Enable explicitly for frontend development while the Phase 3 API is pending.
VITE_USE_MOCK_CAMPAIGNS=false
# success | empty | error; development only
VITE_CAMPAIGN_MOCK_SCENARIO=success
VITE_CAMPAIGN_MOCK_LATENCY=300

# Phase 2 auth. Secrets must be at least 32 characters — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=30
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Auth rate limiting (requests per IP per 15 minutes). Optional; the defaults
# live in apps/api/src/middlewares/rate-limit.middleware.ts.
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_RESET_MAX=5

# Password-reset email delivery. When SMTP_HOST is unset outside production,
# forgot-password returns devResetToken instead of sending an email. In
# production SMTP_HOST/SMTP_FROM/RESET_PASSWORD_URL (https) are required.
# RESET_PASSWORD_URL=https://your-domain/reset-password
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@your-domain

# Optional initial admin account, created by `pnpm db:seed`. Leave unset to skip.
# Never commit a real password.
# ADMIN_EMAIL=admin@example.local
# ADMIN_PASSWORD=
# ADMIN_FULL_NAME=Quản trị viên

